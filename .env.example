# Application
APP_NAME="TaskHub API"
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=local
DEBUG=true

# Database (compose service name is `db` when running in Docker)
POSTGRES_HOST=localhost
# Host port for the compose Postgres; change it if 5432 is already taken locally.
POSTGRES_PORT=5432
POSTGRES_USER=taskhub
POSTGRES_PASSWORD=taskhub
POSTGRES_DB=taskhub

# Optional: full DSN override, wins over the POSTGRES_* values above
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Engine tuning
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
