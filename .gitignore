# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Per-developer compose tweaks (host ports, extra services)
docker-compose.override.yml

# Planning artefacts: blueprints, phase files, review reports, evidence.
# They belong to the working session, not to the codebase — the decisions
# that outlive a session are written into docs/ and into commit messages.
plans/

# Editors / OS
.idea/
.vscode/
.DS_Store
