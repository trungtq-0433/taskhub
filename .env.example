ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">
# Browser origins allowed to call the API: comma-separated exact origins (scheme://host[:port],
# no trailing /). Unset = no origin allowed. `*` allows any, and is refused in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Root log level: DEBUG, INFO, WARNING or ERROR. Unset = DEBUG when DEBUG=true, otherwise INFO.
# uvicorn keeps its own level (its --log-level), so access lines are unaffected.
# LOG_LEVEL=INFO

# Email (optional). Unset SMTP_HOST = no email is sent.
# For local use: `docker compose up -d mailpit`, SMTP_HOST=localhost, read mail at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# true = implicit TLS (port 465); false = plain, upgraded with STARTTLS when the server offers it
# SMTP_USE_TLS=false
# Seconds to wait on the mail server before giving up
# SMTP_TIMEOUT=10
# MAIL_FROM=TaskHub <noreply@taskhub.local>

# Tag cache (optional). Unset REDIS_URL = GET /tags reads Postgres every time.
# For local use: `docker compose up -d redis`
# REDIS_URL=redis://localhost:6379/0
# Seconds to wait on Redis before falling back to Postgres
# REDIS_TIMEOUT=0.5
# Seconds a cached tag page lives
# TAG_CACHE_TTL=300
