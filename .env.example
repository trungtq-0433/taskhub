# Only what actually differs between environments. APP_NAME / APP_VERSION /
# API_PREFIX are the same everywhere and live in app/core/config.py.

# --- Required: the app refuses to start without these -----------------------
ENVIRONMENT=local              # local | test | staging | production

# One URL, not five parts. Real environments get this from the database
# provisioning step (RDS, Neon, Supabase, a Terraform output).
# `postgres://` and `postgresql://` are accepted and upgraded to the async driver.
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub

# --- Optional ---------------------------------------------------------------
DEBUG=true                     # must be false in production, enforced at boot
# DB_ECHO=false                # log every SQL statement
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Read by docker compose, not by the application: host port for the dev
# database. Change it if 5432 is already taken on your machine.
# POSTGRES_HOST_PORT=5432
