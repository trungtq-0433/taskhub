# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Per-developer compose tweaks (host ports, extra services)
docker-compose.override.yml

# Working notes: blueprints, phase files, review evidence, prose docs,
# session journals. They belong to the sessions that produced them. What
# has to outlive a session goes into README.md, into the code itself, or
# into a commit message.
plans/
docs/

# Notes agents keep for themselves between sessions. Machine scratch, not
# project knowledge, and this repository is public.
.claude/

# Editors / OS
.idea/
.vscode/
.DS_Store
