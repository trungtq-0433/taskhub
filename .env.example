ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/<database_name>
DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_urlsafe(48))">

# Email (optional). Unset SMTP_HOST = no email is sent.
# For local use: `docker compose up -d mailpit`, SMTP_HOST=localhost, read mail at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# true = implicit TLS (port 465); false = plain, upgraded with STARTTLS when the server offers it
# SMTP_USE_TLS=false
# Seconds to wait on the mail server before giving up
# SMTP_TIMEOUT=10
# MAIL_FROM=TaskHub <noreply@taskhub.local>

# Tag cache (optional). Unset REDIS_URL = GET /tags reads Postgres every time.
# For local use: `docker compose up -d redis`
# REDIS_URL=redis://localhost:6379/0
