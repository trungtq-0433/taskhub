# Only variables that genuinely differ between environments belong here.
# APP_NAME / APP_VERSION / API_PREFIX are the same everywhere — they live in
# app/core/config.py.

# --- Required: the app refuses to start without these -----------------------
ENVIRONMENT=local              # local | test | staging | production
POSTGRES_PASSWORD=taskhub      # production injects this from a secret store

# --- Database ---------------------------------------------------------------
POSTGRES_HOST=localhost        # `db` when the app runs inside docker compose
POSTGRES_PORT=5432             # host-side port; change it if 5432 is taken
POSTGRES_USER=taskhub
POSTGRES_DB=taskhub

# A managed database (RDS, Neon, Supabase) hands out one DSN instead of the
# parts above. Set it and it wins over every POSTGRES_* value.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# --- Optional ---------------------------------------------------------------
DEBUG=true                     # must be false in production, enforced at boot
# DB_ECHO=false                # log every SQL statement
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
